# All optional — the app falls back to the public Coras sandbox + CDN, so it
# runs with no configuration. Copy to `.env` to point at a different backend.

# Coras API origin (default: https://sandbox.coras.io)
VITE_API_HOST=
# Distributor id (default: the shared example distributor)
VITE_DISTRIBUTOR_ID=
# SDK shared-asset base (default: https://assets.sandbox.coras.io/shared)
VITE_ASSETS_URL=
# Extra hosts the dev server may be reached on, comma-separated
VITE_ALLOWED_HOSTS=
