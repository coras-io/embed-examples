# All optional - the app falls back to the public Coras sandbox + CDN, so it
# runs with no configuration. These are read by `config/environment.js` from the
# shell environment at build time (Ember's config is a plain Node module). Set
# them in your shell (or a tool that exports them) before `pnpm dev` / `pnpm build`.

# Coras API origin (default: https://sandbox.coras.io)
CORAS_API_HOST=
# Distributor id (default: the shared example distributor)
CORAS_DISTRIBUTOR_ID=
# SDK shared-asset base (default: https://assets.sandbox.coras.io/shared)
CORAS_ASSETS_URL=
