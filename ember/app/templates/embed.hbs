{{! One persistent mount for the landing page and every child route. Child route }}
{{! templates are empty: the mount reads the URL and renders the matching page. }}
<CorasMount
  @page={{this.page}}
  @params={{this.params}}
  @config={{this.config}}
  @chrome={{this.chrome}}
  @onNavigate={{this.onNavigate}}
  @onStateChange={{this.onStateChange}}
/>
{{outlet}}
